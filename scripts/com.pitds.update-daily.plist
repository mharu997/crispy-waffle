<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  PITDS daily update launchd agent.

  Install:
    cp scripts/com.pitds.update-daily.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.pitds.update-daily.plist

  Verify it's loaded:
    launchctl list | grep com.pitds.update-daily

  Run it once on demand (for testing):
    launchctl start com.pitds.update-daily

  Uninstall:
    launchctl unload ~/Library/LaunchAgents/com.pitds.update-daily.plist
    rm ~/Library/LaunchAgents/com.pitds.update-daily.plist

  Schedule: every day (7-day, including weekends) at 17:30 local time.
  launchd weekday integers: 0/7=Sunday, 1=Monday, ..., 6=Saturday.

  Why 7 days: news flows continuously over weekends (earnings preannouncements,
  M&A rumors, geopolitical events). Without weekend runs there's a ~60-hour
  gap from Friday's run to Monday's where weekend news isn't captured until
  Monday — and any article published Friday after 17:30 ET would otherwise
  fall outside Monday's startDate filter, getting permanently skipped.

  Weekend cost is small: prices/corp-actions/fundamentals dedupe to no-ops
  because there's no new market data; only the news step does meaningful
  work, plus a few seconds for the constituents diff against Wikipedia.

  After editing this file, reload the agent so launchd sees the new schedule:
    launchctl unload ~/Library/LaunchAgents/com.pitds.update-daily.plist
    cp scripts/com.pitds.update-daily.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.pitds.update-daily.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.pitds.update-daily</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/mharutyunyan/Projects/Enso/PITDS/scripts/run-update-daily.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/mharutyunyan/Projects/Enso/PITDS</string>

  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Weekday</key><integer>0</integer>
      <key>Hour</key><integer>17</integer>
      <key>Minute</key><integer>30</integer>
    </dict>
    <dict>
      <key>Weekday</key><integer>1</integer>
      <key>Hour</key><integer>17</integer>
      <key>Minute</key><integer>30</integer>
    </dict>
    <dict>
      <key>Weekday</key><integer>2</integer>
      <key>Hour</key><integer>17</integer>
      <key>Minute</key><integer>30</integer>
    </dict>
    <dict>
      <key>Weekday</key><integer>3</integer>
      <key>Hour</key><integer>17</integer>
      <key>Minute</key><integer>30</integer>
    </dict>
    <dict>
      <key>Weekday</key><integer>4</integer>
      <key>Hour</key><integer>17</integer>
      <key>Minute</key><integer>30</integer>
    </dict>
    <dict>
      <key>Weekday</key><integer>5</integer>
      <key>Hour</key><integer>17</integer>
      <key>Minute</key><integer>30</integer>
    </dict>
    <dict>
      <key>Weekday</key><integer>6</integer>
      <key>Hour</key><integer>17</integer>
      <key>Minute</key><integer>30</integer>
    </dict>
  </array>

  <key>StandardOutPath</key>
  <string>/Users/mharutyunyan/Projects/Enso/PITDS/data/raw/launchd_stdout.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/mharutyunyan/Projects/Enso/PITDS/data/raw/launchd_stderr.log</string>

  <!-- Don't run if Mac was asleep; just wait for the next scheduled time. -->
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
