# Copy to .env and fill in. Never commit .env.
# All keys are FREE — see README for signup links.

# Tiingo — free tier at https://www.tiingo.com/
# Used for: EOD prices (always) and News API (`pitds backfill-news`).
# Same key works for both endpoints; News history depth depends on plan tier.
TIINGO_API_KEY=

# OpenFIGI (identifier mapping) — free key at https://www.openfigi.com/api
# Optional: works without a key but has a stricter rate limit.
OPENFIGI_API_KEY=

# SEC EDGAR — REQUIRED. Format: "YourName your.email@example.com"
# EDGAR is free and public; the User-Agent is just so they can contact
# you if your scraper misbehaves. Do not invent a fake email.
SEC_USER_AGENT=

# Optional: override default data directory (defaults to ./data)
# PITDS_DATA_DIR=
